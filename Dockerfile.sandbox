# One throwaway container per attack. Contains ONLY the runner: no app source, no secrets, no pip packages.
# Network, filesystem, user and resource limits are applied by `docker run` (see DOCKER_LIMITS in engine.py).
FROM python:3.12-slim
WORKDIR /sandbox
COPY --chmod=0444 sandbox_runner.py /sandbox/sandbox_runner.py
USER 65534:65534
ENTRYPOINT ["python", "-I", "/sandbox/sandbox_runner.py"]
